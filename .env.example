# Deployment
# Leave COMPOSE_PROFILES empty when the VPS's own Nginx proxies to the app
# (deploy/nginx/host-site.conf). Set to "edge" to run Nginx + Certbot in Docker.
COMPOSE_PROFILES=
DOMAIN=karaokecec.cl
CERTBOT_EMAIL=

# Public (inlined into the client bundle at build time)
NEXT_PUBLIC_APP_URL=https://karaokecec.cl
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
YOUTUBE_API_KEY=
DEVICE_TOKEN_SECRET=
